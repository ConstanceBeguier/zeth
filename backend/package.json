{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-ignition": "^3.1.10",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^6.3.0",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.17.0",
    "hardhat": "^3.22.0",
    "mocha": "^12.0.3",
    "prettier": "^3.10.1",
    "prettier-plugin-solidity": "^2.4.1",
    "solhint": "^6.2.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage",
    "typecheck": "tsc --noEmit",
    "lint:sol": "npm run lint:sol:src && npm run lint:sol:test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:sol && npm run format:check && npm run typecheck",
    "size": "hardhat compile --build-profile production && node scripts/check-contract-size.ts",
    "lint:sol:src": "solhint --noPoster --max-warnings 0 'contracts/**/*.sol'",
    "lint:sol:test": "solhint --noPoster -c .solhint.test.json --ignore-path .solhintignore.test --max-warnings 0 'contracts/**/*.t.sol' 'test/**/*.sol'"
  }
}
